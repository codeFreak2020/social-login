{
  "name": "ravindrasingh0406/social-login",
  "description": "Framework-agnostic social login package for PHP with multiple providers (Google, GitHub)",
  "type": "library",
  "license": "MIT",
  "homepage": "https://github.com/codeFreak2020/social-login",
  "autoload": {
    "psr-4": {
      "SocialLogin\\": "src/"
    }
  },
  "require": {
    "php": ">=8.0",
    "league/oauth2-client": "^2.7",
    "guzzlehttp/guzzle": "^7.8"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.5",
    "illuminate/support": "^10.0 || ^11.0",
    "vlucas/phpdotenv": "^5.6"
  },
  "scripts": {
    "test": "phpunit --colors=always"
  },
  "keywords": [
    "oauth2",
    "social-login",
    "google",
    "github",
    "laravel"
  ],
  "support": {
    "source": "https://github.com/codeFreak2020/social-login",
    "issues": "https://github.com/codeFreak2020/social-login/issues"
  },
  "extra": {
    "laravel": {
      "providers": [
        "SocialLogin\\Laravel\\SocialLoginServiceProvider"
      ],
      "aliases": {
        "SocialLogin": "SocialLogin\\Laravel\\Facades\\SocialLogin"
      }
    }
  }
}
